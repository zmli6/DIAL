# Copy to .env and edit. The SLURM scripts auto-source .env if present.

# Path to your conda installation
export CONDA_SH="$HOME/miniconda3/etc/profile.d/conda.sh"
export CONDA_ENV="dial"

# vLLM server endpoint that dial.inference.proposer talks to
export DIAL_VLLM_ENDPOINT="http://localhost:9300/v1"

# Hugging Face cache (large; point to a scratch volume)
export HF_HOME="$HOME/.cache/huggingface"

# WebShop installation root (only required if you run --env webshop in real mode)
export WEBSHOP_ROOT=""

# OpenRouter API key (only required if you set reflect_backend=openrouter in DIAL config)
# export OPENROUTER_API_KEY=""
